generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
}

enum EventType {
  IN_PERSON
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
  ARCHIVED
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  // Existing users are grandfathered by the migration; new users must verify.
  verificationRequired Boolean @default(true)
  image         String?
  timezone      String?  @db.VarChar(100)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  memberships   OrganizationMember[]
  createdEvents Event[]
  registrations EventRegistration[] @relation("EventAttendee")
  checkedInRegistrations EventRegistration[] @relation("EventCheckInActor")
  bookmarks     EventBookmark[]
  followedOrganizations OrganizationFollower[]
  notifications Notification[]
  eventReminders EventReminderPreference[]
  feedback      EventFeedback[]
  sentInvitations OrganizationInvitation[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  // Better Auth stores its salted password hash here, never plaintext.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// Shared rate limits survive process restarts and multiple application instances.
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Organization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String?
  description String?
  industry    String?
  city        String?
  region      String?
  website     String?
  visualTheme String?
  logoVariant String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  followers   OrganizationFollower[]
  members     OrganizationMember[]
  events      Event[]
  invitations OrganizationInvitation[]
}

enum InvitationRole {
  ADMIN
  EDITOR
  MEMBER
}

model OrganizationInvitation {
  id             String @id @default(cuid())
  organizationId String
  email          String
  role           InvitationRole
  tokenHash      String @unique
  invitedById    String?
  expiresAt      DateTime @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  declinedAt     DateTime? @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  emailSentAt    DateTime? @db.Timestamptz(3)
  emailProviderMessageId String?
  emailLastAttemptAt DateTime? @db.Timestamptz(3)
  emailSendAttempts Int @default(0)
  // Only an application-owned category; never a raw provider error/response.
  emailFailureCategory String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  // Partial unique open-invitation index is maintained in the SQL migration.
  @@index([organizationId, email])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model Event {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  title                String
  description          String?
  shortDescription     String?
  category             String?
  locationName         String?
  city                 String?
  region               String?
  onlineUrl            String?
  coverImage           String?
  startAt              DateTime      @db.Timestamptz(3)
  endAt                DateTime      @db.Timestamptz(3)
  timezone             String        @default("Asia/Yangon")
  eventType            EventType
  status               EventStatus   @default(DRAFT)
  capacity             Int?
  registrationDeadline DateTime?     @db.Timestamptz(3)
  creatorId            String
  organizationId       String?
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  // Preserve authored events; account/org deletion requires an explicit future workflow.
  creator              User          @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  organization         Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  registrations        EventRegistration[]
  bookmarks            EventBookmark[]
  agendaItems          EventAgendaItem[]
  speakers             EventSpeaker[]
  resources            EventResource[]
  reminderPreferences  EventReminderPreference[]
  feedback             EventFeedback[]

  @@index([creatorId])
  @@index([organizationId, startAt])
  @@index([status, startAt])
  // Expression GIN search indexes are maintained in global_search_discovery SQL.
  @@index([category, status, startAt])
}

enum EventResourceType {
  SLIDES
  RECORDING
  LINK
  NOTES
  DOCUMENT
  OTHER
}

model EventAgendaItem {
  id            String @id @default(cuid())
  eventId       String
  title         String
  description   String?
  startAt       DateTime @db.Timestamptz(3)
  endAt         DateTime? @db.Timestamptz(3)
  locationLabel String?
  sortOrder     Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  event         Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
}

model EventSpeaker {
  id        String @id @default(cuid())
  eventId   String
  name      String
  role      String?
  company   String?
  bio       String?
  imageUrl  String?
  sortOrder Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
}

model EventResource {
  id          String @id @default(cuid())
  eventId     String
  title       String
  type        EventResourceType
  url         String
  description String?
  sortOrder   Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, sortOrder])
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
  NO_SHOW
}

model EventRegistration {
  id        String             @id @default(cuid())
  userId    String
  eventId   String
  status    RegistrationStatus @default(REGISTERED)
  createdAt DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @db.Timestamptz(3)
  checkedInAt DateTime?        @db.Timestamptz(3)
  checkedInById String?
  ticketTokenHash String? @unique
  ticketNonce String?
  ticketIssuedAt DateTime? @db.Timestamptz(3)
  user      User               @relation("EventAttendee", fields: [userId], references: [id], onDelete: Cascade)
  checkedInBy User?            @relation("EventCheckInActor", fields: [checkedInById], references: [id], onDelete: SetNull)
  event     Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, status])
  @@index([eventId, createdAt])
  @@index([userId, status])
  @@index([checkedInById])
}

model EventFeedback {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([eventId, createdAt, id])
}

model EventBookmark {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId, createdAt])
}

model OrganizationFollower {
  id             String @id @default(cuid())
  userId         String
  organizationId String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId, createdAt])
}

enum NotificationType {
  EVENT_REMINDER
  EVENT_PUBLISHED
  EVENT_UPDATED
  EVENT_CANCELLED
  REGISTRATION_CONFIRMED
  REGISTRATION_CANCELLED
  SYSTEM
}

model EventReminderPreference {
  id              String @id @default(cuid())
  userId          String
  eventId         String
  reminderMinutes Int
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event           Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId, enabled])
  @@index([enabled, eventId])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  // Server-assigned identity of an occurrence/recipient; never client supplied.
  dedupeKey String @unique
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}
