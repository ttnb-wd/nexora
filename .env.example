# Copy to .env.local; never commit real credentials.
DATABASE_URL=
# Generate a random secret with at least 32 bytes of entropy.
AUTH_SECRET=
# Exact application origin; use HTTPS in production.
APP_URL=http://localhost:3000

# Optional origin for ticket QR and calendar event links. Falls back to APP_URL.
# Keep APP_URL unchanged for Better Auth. PUBLIC_APP_URL must have no path/query/credentials.
# Development: use your PC LAN IPv4 origin (http://<PC-LAN-IP>:3000).
# Production: use the real deployed HTTPS Nexora domain.
PUBLIC_APP_URL=

# Server-only scheduler bearer token; generate independently with at least 32 random bytes.
# Leave unset to disable both POST and Vercel GET reminder jobs. Never prefix with NEXT_PUBLIC_.
# Vercel: set for Production with Type=Secret (formerly Sensitive), then redeploy.
CRON_SECRET=

# Server-only transactional invitations. Verify your own custom sending domain in Resend.
RESEND_API_KEY=
# Examples only; replace with an address on your verified domain.
# EMAIL_FROM="Nexora <hello@nexora.example.com>"
# EMAIL_REPLY_TO="support@nexora.example.com"
EMAIL_FROM=
EMAIL_REPLY_TO=
# Invitation emails require an explicit PUBLIC_APP_URL (HTTPS in production).
