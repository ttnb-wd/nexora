{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "postinstall": "prisma generate",
    "test:auth": "node --test tests/auth-validation.test.mjs",
    "test:organizations": "node --test tests/organization-validation.test.mjs",
    "test:organizations:runtime": "node tests/organization-runtime.mjs",
    "test:events": "node --test tests/event-validation.test.mjs",
    "test:events:runtime": "node tests/event-runtime.mjs",
    "test:events:public:runtime": "node tests/public-event-runtime.mjs",
    "test:events:public": "node --test tests/public-event-mapper.test.mjs",
    "test:organizations:public": "node --test tests/public-organization-queries.test.mjs",
    "test:organizations:public:runtime": "node tests/public-organization-runtime.mjs",
    "test:participation": "node --test tests/participation.test.mjs",
    "test:participation:runtime": "node tests/participation-runtime.mjs",
    "test:participation:readonly": "node tests/participation-readonly.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@next/env": "16.3.8",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.7",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.5"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  },
  "type": "module"
}
